{
  "$schema": "https://cursor.com/schemas/mcp.json",
  "description": "MCP usage map for MSc Dissertation / deepaft. Built-in Cursor MCPs are enabled in Settings; this file documents project-specific routing.",
  "projectMcps": {
    "cursor-ide-browser": {
      "useFor": [
        "GDC TCGA portal navigation",
        "Synapse BraTS 2024 download pages",
        "OncoLnc gene lookup (expression only)"
      ],
      "notes": "User must authenticate manually for Synapse/GDC."
    },
    "cursor-app-control": {
      "useFor": [
        "open_resource for notebooks and results",
        "rename_chat for dissertation session titles"
      ]
    },
    "cursor": {
      "tools": ["CreateGoal", "UpdateGoal"],
      "useFor": [
        "Long-running dissertation milestones (see PROJECT_TASKS.md)"
      ]
    }
  },
  "notIncludedOnPyPI": [
    "BraTS NIfTI loaders",
    "Synapse credentials",
    "TCGA raw clinical exports in repo"
  ]
}
